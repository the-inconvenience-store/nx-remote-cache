# --- Required ---------------------------------------------------------------

# Trusted read/write tokens: a comma-separated list (spaces around commas are
# removed). Each token is nonempty, without whitespace, and listed once.
# List old and new tokens together to rotate without downtime.
NX_CACHE_ACCESS_TOKEN=your-secure-token

# --- Optional ---------------------------------------------------------------

# Download-only tokens: a comma-separated list. If set, each token must be
# nonempty, contain no whitespace, be listed once, and not appear in
# NX_CACHE_ACCESS_TOKEN. Leave unset (not empty) to disable.
# NX_CACHE_READ_ONLY_TOKEN=your-read-only-token

# Listen port. Default: 3000
PORT=3000

# Port for Prometheus /metrics (plain HTTP, no auth). "0" turns metrics off;
# any value other than 0-65535, including empty, prevents startup.
# Default: 9090
# METRICS_PORT=9090

# AWS region. Default: us-east-1
AWS_REGION=us-east-1

# Bucket holding cache artifacts. Default: nx-cloud
S3_BUCKET_NAME=nx-cloud

# Endpoint for S3-compatible storage. Leave unset for AWS S3.
# S3_ENDPOINT_URL=http://localhost:3900

# Bucket addressing: "true" for path-style, "false" for virtual-hosted style.
# Unset: virtual-hosted on AWS S3, path-style when S3_ENDPOINT_URL is set.
# Any other value, including empty, prevents startup. On AWS, a bucket name
# containing a dot can fail TLS in virtual-hosted style; use "true" for it.
# S3_FORCE_PATH_STYLE=true

# Static S3 credentials: set both or neither. When neither is set the AWS
# default credential chain is used (env/profile, IRSA, instance profile).
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# "true" (default): storage failures degrade to GET 404 / PUT 403.
# "false": storage failures return 503. Any other value prevents startup.
# NX_CACHE_FAIL_OPEN=true

# Largest upload Content-Length in bytes; a larger upload gets 403 and is not
# stored. A whole number of 0 or more; anything else prevents startup.
# Default: 0 (no limit)
# NX_CACHE_MAX_ARTIFACT_BYTES=0

# Stop an artifact transfer when none of its bytes move for this long, so a
# stalled S3 transfer cannot hang the Nx run. There is no limit on the
# total transfer time. A Go duration greater than zero (e.g. 30s, 2m);
# anything else, including empty, prevents startup. Default: 60s
# NX_CACHE_STALL_TIMEOUT=60s

# HTTPS: set both to PEM file paths, or neither for plain HTTP.
# TLS_CERT_PATH=/path/to/tls.crt
# TLS_KEY_PATH=/path/to/tls.key
